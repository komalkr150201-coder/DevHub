# DevHub Environment Configuration

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MongoDB Atlas or Local MongoDB)
# If not provided, DevHub falls back automatically to an in-memory MongoDB instance for immediate local testing
MONGO_URI=mongodb://localhost:27017/devhub

# Authentication & Security
# 32+ character random string for signing JWT cookies
JWT_SECRET=devhub_super_secret_jwt_key_at_least_32_characters_long_2026
# 32-character AES-256 encryption key for sensitive tokens at rest
ENCRYPTION_KEY=devhub_secret_aes_key_32_chars_ok

# GitHub OAuth 2.0 Credentials (Create at https://github.com/settings/developers)
# Authorization callback URL: http://localhost:5000/auth/github/callback
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:5000/auth/github/callback

# Background Sync
SYNC_INTERVAL_HOURS=6
